<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.workit.domain.notification.mapper.NotificationMapper">

    <!--
        알림 목록 조회 - 커서 기반 페이지네이션.
        - notification_histories 테이블에서 user_id 로 사용자 알림 조회
        - ORDER BY id DESC (최신순 정렬 — created_at 이 아닌 id 기준으로 안정적인 순서 보장)
        - cursor(id) 가 있으면 id < cursor 조건 적용 — 이전 페이지의 마지막 ID보다 오래된 알림 조회
        - size + 1 개 조회하여 hasNext 판단 (21번째 데이터 존재 여부)
        - Mapper 는 조회만 담당 ( hasNext/nextCursor 계산은 Service)
    -->
    <select id="selectNotificationList"
            resultType="com.workit.domain.notification.vo.NotificationVO">
        SELECT id                AS notification_id,
               category,
               important,
               title,
               content,
               reference_type   AS reference_type,
               reference_id     AS reference_id,
               read             AS is_read,
               created_at       AS created_at
        FROM notification_histories
        WHERE user_id = #{userId}
        <if test="cursor != null">
            AND id &lt; #{cursor}
        </if>
        ORDER BY id DESC
        LIMIT #{size}
    </select>

    <!--
        읽지 않은 알림 개수 조회 - 단순 COUNT 쿼리.
        - notification_histories 테이블에서 user_id + read = 0 조건으로 COUNT
        - Service 계층에서 사용자별 unread count를 반환
    -->
    <select id="countUnreadNotifications" resultType="int">
        SELECT COUNT(*)
        FROM notification_histories
        WHERE user_id = #{userId}
          AND read = 0
    </select>

    <!--
        알림 존재 여부 확인 - notificationId와 userId가 모두 일치하는 알림이 존재하는지 확인한다.
        - 소유권 검증 포함 (user_id 조건)
        - 알림이 존재하면 true, 존재하지 않으면 false를 반환한다.
        - existsNotification은 PK 기준 조회이므로 성능 영향이 미미하다.
    -->
    <select id="existsNotification" resultType="boolean">
        SELECT EXISTS (
            SELECT 1
            FROM notification_histories
            WHERE id = #{notificationId}
              AND user_id = #{userId}
        )
    </select>

    <!--
        알림 단건 읽음 처리 - notificationId와 userId가 모두 일치하는 알림의 read 값을 1로 변경한다.
        - 소유권 검증: user_id 조건을 반드시 포함하여 다른 사용자의 알림을 변경하지 않도록 한다.
        - 이미 읽은 알림(read=1)을 다시 요청하면 MySQL affected_rows=0을 반환하지만,
          existsNotification으로 사전 검증하므로 404 없이 정상 처리된다.
        - notificationId가 존재하지 않거나 다른 사용자의 알림이면 영향 행 수 0을 반환한다.
    -->
    <update id="markAsRead">
        UPDATE notification_histories
        SET read = 1
        WHERE id = #{notificationId}
          AND user_id = #{userId}
    </update>

    <!--
        전체 알림 읽음 처리 - 현재 사용자의 읽지 않은 모든 알림을 읽음 상태로 변경한다.
        - 소유권 검증: user_id 조건을 반드시 포함하여 다른 사용자의 알림을 변경하지 않도록 한다.
        - 읽지 않은 알림이 없는 경우 affected_rows=0을 반환하지만, 이는 정상적인 상태이다.
        - 영향 행 수를 반환하여 Service 계층에서 사용할 수 있다.
    -->
    <update id="markAllAsRead">
        UPDATE notification_histories
        SET read = 1
        WHERE user_id = #{userId}
          AND read = 0
    </update>

    <!--
        알림 수신 설정 조회 - user_notification_settings 테이블에서 사용자의 알림 설정을 조회한다.
        - user_id 조건을 반드시 포함하여 현재 로그인한 사용자의 설정만 조회한다.
        - 회원가입 시 알림 설정 레코드가 반드시 생성되므로 정상적인 사용자는 항상 한 건이 존재한다.
        - TINYINT(1) → Boolean 매핑은 MyBatis가 자동 처리한다.
        - 조회 결과가 없는 경우 null을 반환한다.
    -->
    <select id="selectNotificationSettings"
            resultType="com.workit.domain.notification.vo.NotificationSettingsVO">
        SELECT user_id           AS user_id,
               budget_notify     AS budget_notify,
               transfer_notify   AS transfer_notify,
               payment_notify    AS payment_notify,
               workation_notify  AS workation_notify,
               settlement_notify AS settlement_notify,
               schedule_notify   AS schedule_notify,
               updated_at        AS updated_at
        FROM user_notification_settings
        WHERE user_id = #{userId}
    </select>

    <!--
        알림 수신 설정 변경 - 동적 UPDATE로 전달된 필드만 변경한다.
        - 전달되지 않은 필드는 기존 DB 값을 그대로 유지한다.
        - user_id 조건을 반드시 포함하여 다른 사용자의 설정은 변경되지 않는다.
        - SET 절이 비어있는 경우(모든 필드 null) SQL 오류가 발생하지 않도록 주의한다.
          서비스 계층에서 모든 필드 null 검증을 수행하여 이 쿼리에 도달하지 않도록 한다.
        - UPDATE 결과 affected_rows를 반환한다 (0이면 레코드 미존재).
    -->
    <update id="updateNotificationSettings">
        UPDATE user_notification_settings
        <set>
            <if test="settings.budgetNotify != null">
                budget_notify = #{settings.budgetNotify},
            </if>
            <if test="settings.transferNotify != null">
                transfer_notify = #{settings.transferNotify},
            </if>
            <if test="settings.paymentNotify != null">
                payment_notify = #{settings.paymentNotify},
            </if>
            <if test="settings.workationNotify != null">
                workation_notify = #{settings.workationNotify},
            </if>
            <if test="settings.settlementNotify != null">
                settlement_notify = #{settings.settlementNotify},
            </if>
            <if test="settings.scheduleNotify != null">
                schedule_notify = #{settings.scheduleNotify},
            </if>
        </set>
        WHERE user_id = #{userId}
    </update>

</mapper>
