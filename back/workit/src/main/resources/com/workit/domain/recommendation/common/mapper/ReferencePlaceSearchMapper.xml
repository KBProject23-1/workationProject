<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.workit.domain.recommendation.common.mapper.ReferencePlaceSearchMapper">

    <select id="selectReferencePlaceCandidatesByName"
            resultType="com.workit.domain.recommendation.common.vo.ReferencePlaceCandidateVO">
        SELECT m.id           AS merchant_id,
               m.name         AS merchant_name,
               m.category,
               m.latitude,
               m.longitude,
               FALSE AS reserved
          FROM merchants m
         WHERE m.name LIKE CONCAT('%', #{keyword}, '%')
         ORDER BY m.name ASC,
                  m.id ASC
    </select>

</mapper>

