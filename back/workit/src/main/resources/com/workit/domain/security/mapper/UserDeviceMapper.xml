<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.workit.domain.security.mapper.UserDeviceMapper">

    <!--
        PIN 검증용 기기 조회 - (user_id, device_id) UNIQUE 조합
        결과 없음 → null 반환, 미등록 기기 판단은 Service(PinValidator)에서 수행
    -->
    <select id="findPinHashByUserIdAndDeviceId" resultType="java.lang.String">
        SELECT pin_hash
        FROM user_device
        WHERE user_id = #{userId}
          AND device_id = #{deviceId}
    </select>

</mapper>
