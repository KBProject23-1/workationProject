<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.workit.domain.auth.mapper.AuthMapper">

    <!--
        약관 목록 전체 조회.
        화면 노출 순서 = 필수 먼저(required DESC), 그 다음 id 오름차순으로 고정
    -->
    <select id="selectTermsList"
            resultType="com.workit.domain.auth.vo.TermsVO">
        SELECT id,
               title,
               content,
               required,
               created_at
        FROM terms
        ORDER BY required DESC, id ASC
    </select>

    <!--
        필수 약관 ID 목록 조회.
        - 회원가입 완료 시 agreedTermsIds 검증 기준 (terms.required = 1)
        - LONGTEXT 본문(content)은 읽지 않아 약관 목록 조회보다 가볍다
    -->
    <select id="selectRequiredTermsIds" resultType="java.lang.Long">
        SELECT id
        FROM terms
        WHERE required = 1
        ORDER BY id ASC
    </select>

    <!--
        주어진 약관 ID 중 존재하는 ID 만 조회.
        - terms 마스터 기준 존재 여부 검증용 (IN 쿼리)
        - 결과 목록 크기와 요청 ID 목록 크기가 다르면 존재하지 않는 약관이 섞인 것
    -->
    <select id="selectExistingTermIds" resultType="java.lang.Long">
        SELECT id
        FROM terms
        WHERE id IN
        <foreach collection="termIds" item="termId" open="(" separator="," close=")">
            #{termId}
        </foreach>
    </select>

    <!--
        CI 중복 가입 조회.
        - knowledge.md: 검색용 개인정보는 SHA-256 hash 로 저장 → user_auth.identity_ci_hash 조회
        - Mapper 는 조회만 담당 (비즈니스 판단은 Service)
    -->
    <select id="countByCiHash" resultType="int">
        SELECT COUNT(*)
        FROM user_auth
        WHERE identity_ci_hash = #{ciHash}
    </select>

    <!--
        회원가입 이메일 중복 확인.
        - users.email_hash (SHA-256, UNIQUE) 대상 조회
        - email_encrypt(원문)은 복호화하지 않고 hash 만 사용 (knowledge.md: 검색용 hash 저장)
        - Mapper 는 조회만 담당 (비즈니스 판단은 Service)
    -->
    <select id="countByEmailHash" resultType="int">
        SELECT COUNT(*)
        FROM users
        WHERE email_hash = #{emailHash}
    </select>

    <!--
        회원가입 완료 닉네임 중복 확인.
        - user_profile.nickname (UNIQUE) 대상 조회
        - Mapper 는 조회만 담당 (비즈니스 판단은 Service)
    -->
    <select id="countByNickname" resultType="int">
        SELECT COUNT(*)
        FROM user_profile
        WHERE nickname = #{nickname}
    </select>

    <!--
        회원가입 완료 - users insert.
        - useGeneratedKeys: 자동 생성 PK 를 UserVO.id 로 채운다
        - email_hash/phone_number_hash(SHA-256), email_encrypt/name_encrypt/phone_number_encrypt(AES-256)
          는 Service Layer 에서 암호화/해시 후 전달 (Mapper 에서 암호화 금지)
        - status/created_at/updated_at/deleted_at 은 DB 기본값(ACTIVE, CURRENT_TIMESTAMP) 사용
    -->
    <insert id="insertUser"
            parameterType="com.workit.domain.auth.vo.UserVO"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO users (email_hash, email_encrypt, name_encrypt,
                           phone_number_hash, phone_number_encrypt)
        VALUES (#{emailHash}, #{emailEncrypt}, #{nameEncrypt},
                #{phoneNumberHash}, #{phoneNumberEncrypt})
    </insert>

    <!--
        회원가입 완료 - user_auth insert.
        - user_id 는 users insert 후 생성된 PK
        - password_hash(BCrypt), identity_ci_hash(SHA-256), identity_ci_encrypt(AES-256) 는 Service Layer 에서 처리
    -->
    <insert id="insertUserAuth"
            parameterType="com.workit.domain.auth.vo.UserAuthVO"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO user_auth (user_id, password_hash, identity_ci_hash, identity_ci_encrypt)
        VALUES (#{userId}, #{passwordHash}, #{identityCiHash}, #{identityCiEncrypt})
    </insert>

    <!--
        회원가입 완료 - user_profile insert (nickname 저장).
        - nickname 은 Service Layer 에서 중복 검증 후 저장
        - company_name 은 선택값이라 회원가입 시점에는 insert 하지 않는다
    -->
    <insert id="insertUserProfile"
            parameterType="com.workit.domain.auth.vo.UserProfileVO"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO user_profile (user_id, nickname)
        VALUES (#{userId}, #{nickname})
    </insert>

    <!--
        회원가입 완료 - user_terms_agreements 일괄 insert (약관 동의 저장).
        - ERD 기준 테이블: user_terms_agreements (user_id, term_id, agreed_at)
        - agreed_at 은 DB 기본값(CURRENT_TIMESTAMP) — insert 하지 않는다
        - 약관 검증(필수 여부)은 Service Layer 에서 수행 후 동의 목록만 전달한다
    -->
    <insert id="insertUserTerms">
        INSERT INTO user_terms_agreements (user_id, term_id)
        VALUES
        <foreach collection="termIds" item="termId" separator=",">
            (#{userId}, #{termId})
        </foreach>
    </insert>

    <!--
        PASSWORD 로그인 - 이메일(SHA-256 hash) 기준 회원 + 비밀번호 hash 조회.
        - users.email_hash(UNIQUE) 기준, user_auth JOIN 으로 password_hash 함께 조회
        - email_encrypt(원문)는 SELECT 하지 않는다 (knowledge.md: 원문 조회 금지)
        - 결과 없음 → Mapper 는 null 반환, 인증 실패(INVALID_CREDENTIALS) 판단은 Service
    -->
    <select id="findUserByEmailHash"
            resultType="com.workit.domain.auth.vo.LoginUserVO">
        SELECT u.id,
               u.status,
               u.name_encrypt,
               a.password_hash
        FROM users u
                 JOIN user_auth a ON a.user_id = u.id
        WHERE u.email_hash = #{emailHash}
    </select>

    <!--
        PASSWORD 로그인 - 휴대폰 번호(SHA-256 hash) 기준 회원 + 비밀번호 hash 조회.
        - users.phone_number_hash(UNIQUE) 기준, user_auth JOIN 으로 password_hash 함께 조회
        - phone_number_encrypt(원문)는 SELECT 하지 않는다 (knowledge.md: 원문 조회 금지)
        - 결과 없음 → Mapper 는 null 반환, 인증 실패(INVALID_CREDENTIALS) 판단은 Service
    -->
    <select id="findUserByPhoneHash"
            resultType="com.workit.domain.auth.vo.LoginUserVO">
        SELECT u.id,
               u.status,
               u.name_encrypt,
               a.password_hash
        FROM users u
                 JOIN user_auth a ON a.user_id = u.id
        WHERE u.phone_number_hash = #{phoneHash}
    </select>

    <!--
        PIN 로그인 - 등록 기기(device_id) 기준 회원 + PIN hash 조회.
        - user_device(device_id) + users JOIN 으로 pin_hash/status/name 함께 조회
        - UNIQUE(user_id, device_id) 이므로 device_id 당 1건이 원칙이지만 LIMIT 1 로 안전 처리
        - 결과 없음 → Mapper 는 null 반환, 인증 실패(INVALID_CREDENTIALS) 판단은 Service
    -->
    <select id="findUserByDeviceId"
            resultType="com.workit.domain.auth.vo.LoginUserVO">
        SELECT u.id,
               u.status,
               u.name_encrypt,
               d.pin_hash
        FROM users u
                 JOIN user_device d ON d.user_id = u.id
        WHERE d.device_id = #{deviceId}
        LIMIT 1
    </select>

</mapper>
