<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.workit.domain.user.mapper.UserMapper">

    <!--
        내 프로필 조회 - 로그인 사용자 기본 정보 + 프로필 정보 함께 조회.
        - users + user_profile LEFT JOIN — 프로필 미등록 회원은 nickname/company_name/profile_id 가 null
        - email_encrypt/name_encrypt/phone_number_encrypt 는 AES 암호화본이므로 SELECT 가능 —
          복호화는 Service Layer 에서만 수행 (knowledge.md: 원문 컬럼 없음, 복호화는 Service)
        - status 도 함께 조회 — 탈퇴/차단 등 비활성 여부 판단은 Service (Mapper 비즈니스 로직 금지)
        - 결과 없음 → Mapper 는 null 반환, USER_NOT_FOUND(404) 판단은 Service
    -->
    <select id="selectMyProfileByUserId"
            resultType="com.workit.domain.user.vo.MyProfileVO">
        SELECT u.id                  AS user_id,
               u.status,
               u.email_encrypt,
               u.name_encrypt,
               u.phone_number_encrypt,
               up.id                 AS profile_id,
               up.nickname,
               up.company_name
        FROM users u
                 LEFT JOIN user_profile up ON up.user_id = u.id
        WHERE u.id = #{userId}
    </select>

    <!--
        프로필 최초 등록 - 닉네임 중복 확인.
        - user_profile.nickname (UNIQUE) 대상 조회
        - Mapper 는 조회만 담당 (중복 판단은 Service — DUPLICATE_NICKNAME)
    -->
    <select id="countByNickname" resultType="int">
        SELECT COUNT(*)
        FROM user_profile
        WHERE nickname = #{nickname}
    </select>

    <!--
        프로필 최초 등록 - user_profile insert (nickname/company_name 저장).
        - nickname/companyName 은 Service Layer 에서 검증 후 전달 (Mapper 에서 검증 금지)
        - useGeneratedKeys: 자동 생성 PK 를 UserProfileVO.id 로 채운다 (응답 profileId 용)
        - created_at/updated_at 은 DB 기본값(CURRENT_TIMESTAMP) 사용
    -->
    <insert id="insertUserProfile"
            parameterType="com.workit.domain.user.vo.UserProfileVO"
            useGeneratedKeys="true"
            keyProperty="id">
        INSERT INTO user_profile (user_id, nickname, company_name)
        VALUES (#{userId}, #{nickname}, #{companyName})
    </insert>

    <!--
        프로필 수정 - 닉네임 중복 조회 (자기 자신 제외).
        - 변경 요청 닉네임이 다른 사용자의 프로필에서 이미 사용 중인지 확인
        - 기존 닉네임과 동일하면 Service 에서 중복 확인을 건너뛴다 (본인 제외 조건과 함께 이중 방어)
        - Mapper 는 조회만 담당 (중복 판단은 Service — DUPLICATE_NICKNAME)
    -->
    <select id="countByNicknameExcludingUserId" resultType="int">
        SELECT COUNT(*)
        FROM user_profile
        WHERE nickname = #{nickname}
          AND user_id != #{userId}
    </select>

    <!--
        프로필 수정 - user_profile 부분 수정 (PATCH: 전달된 값만 UPDATE).
        - <set> + <if>: nickname 은 null 이 아닌 필드만, company_name 은 updateCompanyName=true 일 때만
          UPDATE 문에 포함된다 (PATCH 특성 반영 — 미전달 필드는 기존 값 유지)
        - companyName 이 요청에 포함되면 updateCompanyName=true 가 되어 값(또는 null → NULL/삭제)으로 저장된다
        - Service Layer 에서 검증/trim 후 전달 (Mapper 에서 검증 금지)
        - updated_at 은 DB ON UPDATE CURRENT_TIMESTAMP 로 자동 갱신
        - 동시 요청으로 인한 nickname UNIQUE 충돌은 DuplicateKeyException → 409 매핑 (Service)
    -->
    <update id="updateUserProfile"
            parameterType="com.workit.domain.user.vo.UserProfileVO">
        UPDATE user_profile
        <set>
            <if test="nickname != null">
                nickname = #{nickname},
            </if>
            <if test="updateCompanyName">
                company_name = #{companyName},
            </if>
        </set>
        WHERE user_id = #{userId}
    </update>

    <!--
        회원 탈퇴 - users 상태 WITHDRAWN 전환 + deleted_at 기록 (Soft Delete).
        - knowledge.md Withdrawal Policy: users.status = WITHDRAWN, deleted_at 에 탈퇴 시간 기록
        - ERD 기준 deleted_at 은 NOT NULL(DEFAULT CURRENT_TIMESTAMP) — 탈퇴 시 NOW() 로 갱신한다
        - status != 'WITHDRAWN' 조건: 이미 탈퇴된 회원은 갱신하지 않아 재탈퇴 방지
          (조회-갱신 사이 동시 요청 Race Condition 최종 방어선 — 0 row 반환 시 Service 에서 처리)
        - 금융 거래/결제/지갑 데이터는 삭제하지 않는다 (Mapper 는 users 테이블만 UPDATE)
    -->
    <update id="updateUserStatusToWithdrawn">
        UPDATE users
        SET status     = 'WITHDRAWN',
            deleted_at = NOW(),
            updated_at = CURRENT_TIMESTAMP
        WHERE id = #{userId}
          AND status != 'WITHDRAWN'
    </update>

    <!--
        휴대폰 번호 변경 - 휴대폰 번호(SHA-256 hash) 중복 조회 (자기 자신 제외).
        - users.phone_number_hash (UNIQUE) 대상
        - 변경 요청 번호가 다른 사용자에게 이미 등록되어 있는지 확인 (본인은 제외)
        - 개인정보 원문(phone_number_encrypt)은 조회하지 않는다 (knowledge.md: 검색용 hash)
        - Mapper 는 조회만 담당 (중복 판단은 Service — PHONE_ALREADY_IN_USE)
    -->
    <select id="countByPhoneHashExcludingUserId" resultType="int">
        SELECT COUNT(*)
        FROM users
        WHERE phone_number_hash = #{phoneHash}
          AND id != #{userId}
    </select>

    <!--
        휴대폰 번호 변경 - users 휴대폰 번호 갱신.
        - phone_number_encrypt 는 Service Layer 에서 AES-256 암호화 후 전달 (Mapper 에서 암호화 금지)
        - phone_number_hash 는 Service Layer 에서 SHA-256 생성 후 전달 (검색용 hash — knowledge.md)
        - status != 'WITHDRAWN' 조건: 조회-갱신 사이 동시 탈퇴 Race Condition 최종 방어선
          (0 row 반환 시 Service 에서 USER_ALREADY_WITHDRAWN 처리 — updateUserStatusToWithdrawn 과 동일)
        - updated_at 은 DB ON UPDATE CURRENT_TIMESTAMP 로 자동 갱신
    -->
    <update id="updateUserPhoneNumber">
        UPDATE users
        SET phone_number_hash    = #{phoneNumberHash},
            phone_number_encrypt = #{phoneNumberEncrypt}
        WHERE id = #{userId}
          AND status != 'WITHDRAWN'
    </update>

    <!--
        이메일 인증번호 발송 - 이메일(SHA-256 hash) 중복 조회 (자기 자신 제외).
        - users.email_hash (UNIQUE) 대상
        - 인증번호를 받을 이메일이 다른 사용자에게 이미 등록되어 있는지 확인 (본인은 제외)
        - 개인정보 원문(email_encrypt)은 조회하지 않는다 (knowledge.md: 검색용 hash —
          AuthMapper.countByEmailHash 와 동일 원칙)
        - Mapper 는 조회만 담당 (중복 판단은 Service — EMAIL_ALREADY_IN_USE)
    -->
    <select id="countByEmailHashExcludingUserId" resultType="int">
        SELECT COUNT(*)
        FROM users
        WHERE email_hash = #{emailHash}
          AND id != #{userId}
    </select>

    <!--
        이메일 변경 - users 이메일 갱신.
        - email_encrypt 는 Service Layer 에서 AES-256 암호화 후 전달 (Mapper 에서 암호화 금지)
        - email_hash 는 Service Layer 에서 SHA-256 생성 후 전달 (검색용 hash — knowledge.md)
        - status != 'WITHDRAWN' 조건: 조회-갱신 사이 동시 탈퇴 Race Condition 최종 방어선
          (0 row 반환 시 Service 에서 USER_ALREADY_WITHDRAWN 처리 — updateUserPhoneNumber 와 동일)
        - email_hash UNIQUE 충돌(동시 변경) 은 DuplicateKeyException → 409 매핑 (Service)
        - updated_at 은 DB ON UPDATE CURRENT_TIMESTAMP 로 자동 갱신
    -->
    <update id="updateUserEmail">
        UPDATE users
        SET email_hash    = #{emailHash},
            email_encrypt = #{emailEncrypt}
        WHERE id = #{userId}
          AND status != 'WITHDRAWN'
    </update>

</mapper>
